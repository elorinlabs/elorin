{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "focus-capability",
  "description": "Managed read-only independent Focus viewers",
  "windows": [
    "focus-*"
  ],
  "permissions": [
    "core:default",
    "allow-user-environment",
    "allow-scientific-open",
    "allow-scientific-read",
    "allow-scientific-close",
    "allow-scientific-pause",
    "allow-scientific-stats",
    "allow-scientific-begin",
    "allow-scientific-finish",
    "allow-scientific-validate-slice",
    "allow-binary-open",
    "allow-binary-read",
    "allow-binary-close",
    "allow-binary-search-start",
    "allow-binary-search-step",
    "allow-binary-search-cancel",
    "allow-binary-stats",
    "core:window:allow-is-minimized",
    "core:window:allow-unminimize",
    "allow-productivity-read",
    "allow-platform-capabilities",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-document-fingerprint",
    "core:window:allow-destroy",
    "allow-data-sqlite-open",
    "allow-data-sqlite-read",
    "allow-data-sqlite-close",
    "allow-load-file",
    "allow-read-file-range",
    "allow-file-size",
    "allow-open-file-external",
    "allow-reveal-file",
    "allow-load-related-file",
    "allow-file-revision",
    "allow-decode-image-preview",
    "allow-open-external-url",
    "allow-register-media-source",
    "allow-release-media-source",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-focused",
    "allow-window-system-menu",
    "allow-window-chrome-state",
    "core:window:allow-start-resize-dragging",
    "allow-archive-open",
    "allow-archive-release-entry",
    "allow-archive-list",
    "allow-archive-prepare-entry",
    "allow-archive-read-entry",
    "allow-archive-close",
    "allow-archive-extraction-status",
    "allow-focus-take",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen"
  ]
}
